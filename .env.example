# Which AI provider the service calls: anthropic (default), openai, deepseek,
# kimi, or custom (any OpenAI-compatible endpoint).
PROVIDER=anthropic

# Set the key for the provider you chose. The others can stay commented out.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# DEEPSEEK_API_KEY=sk-your-key-here
# MOONSHOT_API_KEY=sk-your-key-here
# PROVIDER_API_KEY=your-key-here       # PROVIDER=custom uses this one

# Optional: override the provider's default model.
# MODEL=claude-haiku-4-5-20251001

# PROVIDER=custom only: the OpenAI-compatible base URL (Ollama, vLLM,
# OpenRouter, and the rest). MODEL is required with it.
# BASE_URL=http://localhost:11434/v1

# PORT=4710
