{
  "manifest_version": 3,
  "name": "TenWords",
  "version": "0.3.0",
  "description": "Every paragraph becomes exactly ten words.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "TenWords — toggle 10-word mode (Alt+T)",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:4710/*", "https://api.anthropic.com/*"],
  "commands": {
    "toggle-tenwords": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Toggle 10-word mode on this page"
    }
  }
}
